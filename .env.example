# ─────────────────────────────────────────────────
# Zetera Backend — Environment Variables Template
# Copy file ini menjadi .env lalu sesuaikan nilainya
# ─────────────────────────────────────────────────

# Database — MySQL lokal via XAMPP / MariaDB
DATABASE_URL="mysql://root:@localhost:3306/zetera"

# JWT Secret & Encryption Master Key
JWT_SECRET="replace-with-a-secure-random-64-character-string"
ENCRYPTION_MASTER_KEY="replace-with-a-secure-random-64-character-string"

# Port server
PORT=5000

# Frontend URL (untuk CORS)
FRONTEND_URL="http://localhost:3000"

# Academic API Polite Pool Email (OpenAlex, Crossref, Unpaywall, Retraction Watch)
ACADEMIC_POLITE_EMAIL="admin@zetera.id"

# Groq LLM API Key (Proposal Co-Writer, AI Suggest Outline, Synthesis, Screening)
GROQ_API_KEY=""

# Optional dedicated Groq API Keys (fallback ke GROQ_API_KEY jika kosong)
GROQ_API_KEY_SCREENING=""
GROQ_API_KEY_FRAMEWORK_RELASI=""
GROQ_API_KEY_FRAMEWORK_CROSS_CHECK_JURNAL=""
GROQ_API_KEY_FRAMEWORK_GENARATE_NODE=""

# Parser & MinerU Settings (Opsional)
# MINERU_PATH="C:\\Users\\Lenovo\\miniforge3\\Scripts\\mineru.exe"
MINERU_PATH=""
GROBID_URL=""

# Optional Academic Provider Keys (DOAJ, OpenAlex, Crossref bebas kuota tanpa key)
SEMANTIC_SCHOLAR_API_KEY=""
CORE_API_KEY=""

# MaiaRouter AI / Vector Embedding (Opsional)
MAIAROUTER_API_KEY=""
MAIAROUTER_BASE_URL="https://api.maiarouter.ai/v1"
MAIAROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"
MAIAROUTER_CHAT_MODEL="xai/grok-4-1-fast-non-reasoning"
EMBEDDING_API_KEY=""
